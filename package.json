{
  "name": "web-ts",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "start": "concurrently --kill-others --success first -n \"REACT,I18N\" -c \"cyan,green\" \"react-app-rewired start\" \"i18next-cli extract --watch\"",
    "build": "react-app-rewired build",
    "postbuild": "ts-node src/tools/postbuild.ts",
    "gen-sitemap": "ts-node src/tools/gen-sitemap.ts",
    "gen-robots": "ts-node src/tools/gen-robots.ts",
    "eject": "react-app-rewired eject",
    "deploy": "gh-pages -d build",
    "deploy-fix": "gh-pages-clean gh-pages -d build",
    "lint": "eslint src",
    "i18n": "i18next-cli extract"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/node": "25.3.5",
    "@types/react": "18.2.28",
    "@types/react-dom": "18.2.7",
    "axios": "^1.14.0",
    "dotenv": "^17.3.1",
    "gh-pages": "^4.0.0",
    "i18next": "^25.8.16",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2",
    "prettier": "^3.0.0",
    "qrcode.react": "^4.2.0",
    "react": "18.3.0",
    "react-dom": "18.3.0",
    "react-hook-form": "^7.79.0",
    "react-i18next": "^16.5.6",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.13.1",
    "react-scripts": "5.0.1",
    "react-toastify": "^11.0.5",
    "styled-components": "6.3.11",
    "typescript": "^5.9.3",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/styled-components": "^5.1.25",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "concurrently": "^9.2.1",
    "eslint": "8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.30.1",
    "i18next-cli": "^1.49.4",
    "react-app-rewire-alias": "^1.1.7",
    "react-app-rewired": "^2.2.1",
    "ts-node": "^10.9.1"
  }
}
