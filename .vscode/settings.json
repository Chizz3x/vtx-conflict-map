{
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "files.associations": {
    ".env.*": "properties"
  },
  "files.eol": "\n",
  "eslint.validate": [
    "typescriptreact",
    "typescript",
    "javascriptreact",
    "javascript"
  ],
  "cSpell.words": ["defaultify"],
  "i18n-ally.localesPaths": ["public/locales"]
}
